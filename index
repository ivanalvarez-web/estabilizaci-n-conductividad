<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analizador de Conductividad</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
    <meta name="description" content="Calculadora de desviación de conductividad para comprobar tolerancias del ±5%.">
</head>
<body>
    <div class="background-mesh"></div>
    <main class="container">
        <header>
            <h1>Análisis de Conductividad</h1>
            <p>Introduce los valores medidos. Verificaremos automáticamente si se encuentran dentro del margen del <strong>±5%</strong>.</p>
        </header>
        
        <section class="input-section glass-panel">
            <form id="data-form">
                <div class="input-group">
                    <input type="number" id="conductivity-input" step="any" placeholder="Ej. 1413 o 12.5" required autocomplete="off">
                    <button type="submit" id="add-btn">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Añadir
                    </button>
                </div>
            </form>
            
            <div class="controls">
                <button type="button" id="clear-btn" class="btn-secondary">Limpiar Datos</button>
            </div>
        </section>

        <section class="results-section">
            <div class="stats-panel glass-panel">
                <div class="stat-box">
                    <span class="stat-label">Promedio</span>
                    <span class="stat-value" id="stat-average">0.00</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">Nº de Datos</span>
                    <span class="stat-value" id="stat-count">0</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">Estado Global</span>
                    <span class="stat-value status-badge" id="stat-status">N/A</span>
                </div>
            </div>

            <div class="list-panel glass-panel">
                <h2>Datos Registrados</h2>
                <div class="table-container">
                    <table id="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Valor</th>
                                <th>Desviación (%)</th>
                                <th>Estado</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody id="data-list">
                            <tr class="empty-row"><td colspan="5">No hay datos introducidos aún.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
    <script src="script.js"></script>
</body>
</html>
